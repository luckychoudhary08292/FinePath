# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database Connection URI (e.g. MongoDB Atlas or local)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/riderwallet?retryWrites=true&w=majority"

# JWT Authentication Secrets
JWT_SECRET="riderwallet_jwt_super_secret_access_key_2026"
JWT_REFRESH_SECRET="riderwallet_jwt_super_secret_refresh_key_2026"

# Port & Server Config
PORT=3000
NODE_ENV="development"

